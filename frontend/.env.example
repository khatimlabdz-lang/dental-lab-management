# API Configuration
REACT_APP_API_URL=http://localhost:3000/api/v1
REACT_APP_API_TIMEOUT=30000

# Application
REACT_APP_ENV=development
REACT_APP_NAME="Dental Lab Management System"
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_SENTRY=false
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_I18N=true

# Third-party Services
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_HOTJAR_ID=

# File Upload
REACT_APP_MAX_FILE_SIZE=104857600
REACT_APP_ALLOWED_FILE_TYPES=.stl,.ply,.dicom,.jpg,.jpeg,.png,.pdf

# Map Configuration (if needed)
REACT_APP_GOOGLE_MAPS_API_KEY=

# WebSocket
REACT_APP_WS_URL=ws://localhost:3000

# Theme
REACT_APP_PRIMARY_COLOR=#1976D2
REACT_APP_SECONDARY_COLOR=#DC004E
