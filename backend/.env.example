# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME="Dental Lab Management System"
APP_SECRET=your_secret_key_here_change_in_production

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_lab
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false
DB_CONNECTION_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRY=7d

# File Storage - AWS S3 or MinIO
STORAGE_TYPE=minio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dental-lab-files

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=dental-lab-files

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@dentallab.com
SMTP_FROM_NAME="Dental Lab Management"

# WhatsApp Integration
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# 3Shape Integration
3SHAPE_API_KEY=
3SHAPE_API_URL=https://api.3shape.com
3SHAPE_WEBHOOK_SECRET=

# Exocad Integration
EXOCAD_API_KEY=
EXOCAD_API_URL=https://api.exocad.com
EXOCAD_WEBHOOK_SECRET=

# Ceramill Motion 2 Integration
CERAMILL_IP_ADDRESS=
CERAMILL_PORT=
CERAMILL_USERNAME=
CERAMILL_PASSWORD=

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=./logs

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
HELMET_ENABLED=true

# AI & Machine Learning
AI_MODEL_ENDPOINT=
AI_API_KEY=

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
FEATURE_QR_CODE=true
FEATURE_WHATSAPP_NOTIFICATIONS=true
FEATURE_AI_PREDICTION=false
FEATURE_MULTI_TENANT=false
